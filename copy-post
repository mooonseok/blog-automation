#!/bin/sh
# 티스토리에 붙여넣을 글 본문(주석 제외)을 클립보드에 복사하고 버전을 남긴다.
#
# 사용법:
#   sh copy-post                가장 최근 글. 처음 복사하는 글이면 바로 복사하고,
#                               이미 복사한 글이면 무엇을 복사할지 고른다
#   sh copy-post u2oDdU6z       폴더 이름 일부나 유튜브 링크로 글 지정
#
# 버전: 현재 post.md를 복사할 때 마지막 버전과 내용이 다르면
#       versions/vN.md로 저장하고 해당 글 폴더를 git 커밋한다.
set -eu

cd "$(dirname "$0")"
export LC_ALL=en_US.UTF-8

die() { echo "$*" >&2; exit 1; }

# post.md에서 <!-- ... --> 주석(확인 필요, 내 생각, 왜: 등)을 뺀 발행본
render() {
  perl -0pe 's/^[ \t]*<!--.*?-->[ \t]*\n//gms; s/[ \t]*<!--.*?-->//gs; s/\n{3,}/\n\n/g' "$1/post.md"
}

title_of() {
  t=$(sed -n 's/^  1\. //p' "$1/publish.md" 2>/dev/null | head -1)
  echo "${t:-$(basename "$1")}"
}

last_version() {
  ls "$1/versions" 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\)\.md$/\1/p' | sort -n | tail -1
}

version_date() {
  sed -n "s/^v$2	//p" "$1/versions/log.tsv" 2>/dev/null | head -1
}

find_post() {
  if [ $# -eq 0 ]; then
    ls -d posts/*/ 2>/dev/null | sort | tail -1 | sed 's:/$::'
    return
  fi
  key=$1
  # 유튜브 링크면 영상 ID만 뽑는다
  id=$(echo "$key" | sed -nE 's/.*(v=|youtu\.be\/|shorts\/)([A-Za-z0-9_-]{11}).*/\2/p')
  if [ -n "$id" ]; then key=$id; fi
  if [ -d "$key" ]; then echo "${key%/}"; return; fi
  matches=$(ls -d posts/*"$key"*/ 2>/dev/null | sed 's:/$::' || true)
  if [ "$(echo "$matches" | grep -c .)" -gt 1 ]; then
    echo "여러 글이 일치함, 더 구체적으로 입력:" >&2
    echo "$matches" >&2
    exit 1
  fi
  echo "$matches"
}

save_version() {  # $1 글 폴더, $2 발행본 파일, $3 버전 번호
  mkdir -p "$1/versions"
  cp "$2" "$1/versions/v$3.md"
  printf 'v%s\t%s\n' "$3" "$(date '+%Y-%m-%d %H:%M')" >> "$1/versions/log.tsv"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    git add "$1"
    git commit -q -m "copy: $(basename "$1") v$3" -- "$1"
    git push -q 2>/dev/null || echo "[알림] 커밋은 했지만 푸시 실패. 나중에 git push" >&2
  fi
}

show_publish_info() {
  echo
  echo "글쓰기: https://moonesok.tistory.com/manage/newpost  (마크다운 모드로 붙여넣기)"
  if [ -f "$1/publish.md" ]; then sed '1d' "$1/publish.md"; fi
}

copy_current() {
  dir=$1
  tmp=$(mktemp)
  render "$dir" > "$tmp"
  last=$(last_version "$dir")
  if [ -n "$last" ] && cmp -s "$tmp" "$dir/versions/v$last.md"; then
    ver=$last
    note="v$last 이후 수정 없음, 버전 유지"
  else
    ver=$(( ${last:-0} + 1 ))
    save_version "$dir" "$tmp" "$ver"
    note="새 버전 저장"
  fi
  pbcopy < "$tmp"
  rm -f "$tmp"
  echo "복사함: $(title_of "$dir") v$ver ($note)"
  pending=$(grep -n '확인 필요' "$dir/post.md" | cut -d: -f1 | tr '\n' ' ' || true)
  if [ -n "$pending" ]; then echo "[주의] 확인 필요 표시가 남은 줄: $pending" >&2; fi
  show_publish_info "$dir"
}

copy_version() {
  pbcopy < "$1/versions/v$2.md"
  echo "복사함: $(title_of "$1") v$2 ($(version_date "$1" "$2")에 저장된 버전)"
  show_publish_info "$1"
}

ask() {
  printf '선택: ' >&2
  read -r answer || answer=q
  echo "$answer"
}

choose_post() {
  echo "어떤 글을 복사할까요?"
  i=0
  for d in $(ls -d posts/*/ | sort -r | sed 's:/$::'); do
    i=$((i + 1))
    v=$(last_version "$d")
    if [ -n "$v" ]; then v="마지막 v$v"; else v="복사한 적 없음"; fi
    echo "  $i) $(title_of "$d")  [$v]"
  done
  echo "  q) 취소"
  answer=$(ask)
  [ "$answer" = q ] && exit 0
  picked=$(ls -d posts/*/ | sort -r | sed 's:/$::' | sed -n "${answer}p")
  [ -n "$picked" ] || die "잘못된 선택: $answer"
  handle "$picked"
}

menu() {
  dir=$1
  last=$(last_version "$dir")
  tmp=$(mktemp)
  render "$dir" > "$tmp"
  if cmp -s "$tmp" "$dir/versions/v$last.md"; then
    current="현재 글 (v$last 이후 수정 없음)"
  else
    current="현재 글 (수정됨 → v$((last + 1))로 저장)"
  fi
  rm -f "$tmp"

  echo "${intro}이미 복사한 글: $(title_of "$dir") (마지막 v$last)"
  intro=""
  echo "  1) $current"
  n=1
  v=$last
  while [ "$v" -ge 1 ]; do
    n=$((n + 1))
    echo "  $n) v$v  $(version_date "$dir" "$v")"
    v=$((v - 1))
  done
  echo "  o) 다른 글 고르기"
  echo "  q) 취소"
  echo "  (엔터 = 1)"
  answer=$(ask)
  case "$answer" in
    ""|1) copy_current "$dir" ;;
    o) choose_post ;;
    q) exit 0 ;;
    *[!0-9]*) die "잘못된 선택: $answer" ;;
    *)
      [ "$answer" -le "$n" ] || die "잘못된 선택: $answer"
      copy_version "$dir" $((last - answer + 2))
      ;;
  esac
}

handle() {
  if [ -z "$(last_version "$1")" ]; then
    copy_current "$1"
  else
    menu "$1"
  fi
}

# 인자 없이 실행했는데 최근 글도 이미 복사했다면 새로 만든 글이 없다는 뜻
intro=""
if [ $# -eq 0 ]; then intro="새 글이 없습니다. "; fi
dir=$(find_post "$@")
[ -n "$dir" ] && [ -f "$dir/post.md" ] || die "글을 찾을 수 없음: ${1:-posts/}"
handle "$dir"

#!/bin/sh
# 티스토리 HTML 모드에 붙여넣을 글 본문(주석 제외, 스타일 적용)을 클립보드에 복사하고 버전을 남긴다.
#
# 사용법:
#   sh copy-post                가장 최근 글. 처음 복사하는 글이면 바로 복사하고,
#                               이미 복사한 글이면 무엇을 복사할지 고른다
#   sh copy-post u2oDdU6z       폴더 이름 일부나 유튜브 링크로 글 지정
#
# 버전: 현재 post.md를 복사할 때 마지막 버전과 내용이 다르면
#       versions/vN.md로 저장하고 posts/ 로컬 저장소에 커밋한다.
set -eu

cd "$(dirname "$0")"
export LC_ALL=en_US.UTF-8

die() { echo "$*" >&2; exit 1; }

# post.md에서 <!-- ... --> 주석(확인 필요, 내 생각, 왜: 등)을 뺀 발행본
render() {
  perl -0pe 's/^[ \t]*<!--.*?-->[ \t]*\n//gms; s/[ \t]*<!--.*?-->//gs; s/\n{3,}/\n\n/g' "$1/post.md"
}

title_of() {
  t=$(sed -n 's/^  1\. //p' "$1/publish.md" 2>/dev/null | head -1)
  echo "${t:-$(basename "$1")}"
}

last_version() {
  ls "$1/versions" 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\)\.md$/\1/p' | sort -n | tail -1
}

version_date() {
  sed -n "s/^v$2	//p" "$1/versions/log.tsv" 2>/dev/null | head -1
}

find_post() {
  if [ $# -eq 0 ]; then
    ls -d posts/*/ 2>/dev/null | sed 's:/$::' | sort | tail -1
    return
  fi
  key=$1
  # 유튜브 링크면 영상 ID만 뽑는다
  id=$(echo "$key" | sed -nE 's/.*(v=|youtu\.be\/|shorts\/)([A-Za-z0-9_-]{11}).*/\2/p')
  if [ -n "$id" ]; then key=$id; fi
  if [ -d "$key" ]; then echo "${key%/}"; return; fi
  matches=$(ls -d posts/*"$key"*/ 2>/dev/null | sed 's:/$::' || true)
  if [ "$(echo "$matches" | grep -c .)" -gt 1 ]; then
    echo "여러 글이 일치함, 더 구체적으로 입력:" >&2
    echo "$matches" >&2
    exit 1
  fi
  echo "$matches"
}

save_version() {  # $1 글 폴더, $2 발행본 파일, $3 버전 번호
  mkdir -p "$1/versions"
  cat "$2" > "$1/versions/v$3.md"
  printf 'v%s\t%s\n' "$3" "$(date '+%Y-%m-%d %H:%M')" >> "$1/versions/log.tsv"
  name=$(basename "$1")
  ensure_posts_repo
  git -C posts add "$name"
  git -C posts commit -q -m "copy: $name v$3" -- "$name"
  # posts 저장소에 원격(백업용 비공개 리포 등)을 직접 연결해 둔 경우에만 푸시한다
  if [ -n "$(git -C posts remote)" ]; then
    git -C posts push -q 2>/dev/null || echo "[알림] 커밋은 했지만 푸시 실패. 나중에 git -C posts push" >&2
  fi
}

# 글은 도구 리포와 분리된 posts/ 전용 로컬 저장소에서 버전을 관리한다 (GitHub에 올리지 않음)
ensure_posts_repo() {
  [ -d posts/.git ] && return
  git -C posts init -q -b main
  for key in user.name user.email; do
    value=$(git config "$key" || true)
    if [ -n "$value" ]; then git -C posts config "$key" "$value"; fi
  done
}

# 발행본(마크다운)을 티스토리 HTML 모드용 HTML로 바꿔 클립보드에 넣고, 미리보기 페이지도 만든다
to_clipboard() {  # $1 글 폴더, $2 발행본 마크다운 파일
  [ -x .venv/bin/python ] || die ".venv가 없음. README의 설치 단계를 먼저 실행"
  html=$(mktemp)
  .venv/bin/python tools/render_post.py < "$2" > "$html"
  # 서식(HTML)과 소스(텍스트)를 함께 넣어 기본모드·HTML 모드 어디에 붙여넣어도 되게 한다
  if ! osascript -l JavaScript tools/set_clipboard_html.js "$html" 2>/dev/null; then
    pbcopy < "$html"
    echo "[알림] 서식 복사 실패, HTML 소스만 복사함 → 반드시 HTML 모드에 붙여넣기" >&2
  fi
  rm -f "$html"
  .venv/bin/python tools/render_post.py --preview < "$2" > "$1/preview.html"
}

show_publish_info() {
  echo
  echo "글쓰기: https://moonesok.tistory.com/manage/newpost"
  echo "  → 기본모드·HTML 모드 어디에 붙여넣어도 같은 모양. 마크다운 모드는 사용하지 않음"
  echo "미리보기: open $1/preview.html"
  if [ -f "$1/publish.md" ]; then sed '1d' "$1/publish.md"; fi
}

# 기계·Codex 수정은 사용자의 수정과 섞이지 않게 posts/ 저장소에 따로 커밋한다 (fix: …)
commit_fix() {  # $1 글 폴더, $2 설명
  ensure_posts_repo
  name=$(basename "$1")
  git -C posts add "$name"
  git -C posts commit -q -m "fix: $name $2" -- "$name" 2>/dev/null || true
}

codex_fix() {  # $1 글 폴더, $2 자동 검사 결과
  command -v codex >/dev/null 2>&1 || die "codex CLI가 없음. 자동 수정(a)만 쓸 수 있음"
  echo "Codex(editor)로 교정하는 중… (1~3분)"
  out=$(mktemp)
  codex exec -m "${CODEX_MODEL:-gpt-6-astra}" -c "model_reasoning_effort=\"${CODEX_EFFORT:-high}\"" \
    --sandbox workspace-write -C "$(pwd)" --ephemeral -o "$out" \
    "너는 .claude/agents/editor.md 에 정의된 역할이다. 그 파일을 끝까지 읽고 그 역할로서만 일한다.
작업 폴더: $1
고칠 파일은 $1/post.md 하나뿐이다. 다른 파일은 수정하지 않는다. 네트워크를 쓰지 않는다.
아래 자동 검사 결과의 오류와 경고를 모두 해결한다. 사실·수치·고유명사·부품 문법(:::)은 바꾸지 않고, 고칠 곳만 최소로 고친다.
$2
마지막 메시지는 고친 항목 수와 바꾼 내용을 한국어로 3줄 이내로 쓴다." >/dev/null 2>&1 || die "Codex 교정 실패"
  sed 's/^/  /' "$out"
  rm -f "$out"
}

copy_current() {
  dir=$1
  # 복사 전에 blog-style 규칙 자동 검사. 오류·경고가 있으면 고치는 방법을 고른다
  while :; do
    report=$(.venv/bin/python tools/lint_post.py "$dir" 2>&1) && ok=1 || ok=0
    if [ "$ok" = 1 ] && ! echo "$report" | grep -q '^\[경고\]'; then
      echo "$report" | tail -1
      break
    fi
    echo "$report"
    echo "  a) 자동 수정 (연결어미 뒤 쉼표 등 기계적인 것만, 즉시)"
    echo "  c) Codex로 교정 (오류·경고 전부, editor 역할로 1~3분)"
    echo "  y) 이대로 복사"
    echo "  n) 취소"
    printf '선택: ' >&2
    read -r choice || choice=n
    case "$choice" in
      a) fixed=$(.venv/bin/python tools/lint_post.py --fix "$dir" | head -1)
         echo "$fixed"
         commit_fix "$dir" "$fixed" ;;
      c) codex_fix "$dir" "$report"
         commit_fix "$dir" "Codex 교정" ;;
      y|Y) break ;;
      *) die "복사하지 않음" ;;
    esac
  done
  tmp=$(mktemp)
  render "$dir" > "$tmp"
  last=$(last_version "$dir")
  if [ -n "$last" ] && cmp -s "$tmp" "$dir/versions/v$last.md"; then
    ver=$last
    note="v$last 이후 수정 없음, 버전 유지"
  else
    ver=$(( ${last:-0} + 1 ))
    save_version "$dir" "$tmp" "$ver"
    note="새 버전 저장"
  fi
  to_clipboard "$dir" "$tmp"
  rm -f "$tmp"
  echo "복사함: $(title_of "$dir") v$ver ($note)"
  pending=$(grep -n '확인 필요' "$dir/post.md" | cut -d: -f1 | tr '\n' ' ' || true)
  if [ -n "$pending" ]; then echo "[주의] 확인 필요 표시가 남은 줄: $pending" >&2; fi
  images=$(grep -c '^\[\[이미지' "$dir/post.md" || true)
  if [ "$images" -gt 0 ]; then
    echo "[이미지] ${images}개 필요. 파일: $dir/images/ · 위치/캡션: $dir/images.md → 티스토리 업로드 후 붙여넣은 글의 '🖼 이미지 N 자리' 상자에 넣고 상자는 지우기"
  fi
  show_publish_info "$dir"
}

copy_version() {
  to_clipboard "$1" "$1/versions/v$2.md"
  echo "복사함: $(title_of "$1") v$2 ($(version_date "$1" "$2")에 저장된 버전)"
  show_publish_info "$1"
}

ask() {
  printf '선택: ' >&2
  read -r answer || answer=q
  echo "$answer"
}

choose_post() {
  echo "어떤 글을 복사할까요?"
  i=0
  for d in $(ls -d posts/*/ | sed 's:/$::' | sort -r); do
    i=$((i + 1))
    v=$(last_version "$d")
    if [ -n "$v" ]; then v="마지막 v$v"; else v="복사한 적 없음"; fi
    echo "  $i) $(title_of "$d")  [$v]"
  done
  echo "  q) 취소"
  answer=$(ask)
  [ "$answer" = q ] && exit 0
  picked=$(ls -d posts/*/ | sed 's:/$::' | sort -r | sed -n "${answer}p")
  [ -n "$picked" ] || die "잘못된 선택: $answer"
  handle "$picked"
}

menu() {
  dir=$1
  last=$(last_version "$dir")
  tmp=$(mktemp)
  render "$dir" > "$tmp"
  if cmp -s "$tmp" "$dir/versions/v$last.md"; then
    current="현재 글 (v$last 이후 수정 없음)"
  else
    current="현재 글 (수정됨 → v$((last + 1))로 저장)"
  fi
  rm -f "$tmp"

  echo "${intro}이미 복사한 글: $(title_of "$dir") (마지막 v$last)"
  intro=""
  echo "  1) $current"
  n=1
  v=$last
  while [ "$v" -ge 1 ]; do
    n=$((n + 1))
    echo "  $n) v$v  $(version_date "$dir" "$v")"
    v=$((v - 1))
  done
  echo "  o) 다른 글 고르기"
  echo "  q) 취소"
  echo "  (엔터 = 1)"
  answer=$(ask)
  case "$answer" in
    ""|1) copy_current "$dir" ;;
    o) choose_post ;;
    q) exit 0 ;;
    *[!0-9]*) die "잘못된 선택: $answer" ;;
    *)
      [ "$answer" -le "$n" ] || die "잘못된 선택: $answer"
      copy_version "$dir" $((last - answer + 2))
      ;;
  esac
}

handle() {
  if [ -z "$(last_version "$1")" ]; then
    copy_current "$1"
  else
    menu "$1"
  fi
}

# 인자 없이 실행했는데 최근 글도 이미 복사했다면 새로 만든 글이 없다는 뜻
intro=""
if [ $# -eq 0 ]; then intro="새 글이 없습니다. "; fi
dir=$(find_post "$@")
[ -n "$dir" ] && [ -f "$dir/post.md" ] || die "글을 찾을 수 없음: ${1:-posts/}"
handle "$dir"
